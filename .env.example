# QSentinel — frontend environment
#
# Copy to `.env.local`. Only VITE_* keys reach the browser bundle.
# Never put secrets here: everything in VITE_* is public to anyone who loads
# the page. The backend is expected to hold its own auth.

# mock = local simulation (default, so the app always boots with no server)
# http = talk to the team's backend
VITE_API_MODE=mock

# base URL of the backend, used only when VITE_API_MODE=http
VITE_API_URL=http://127.0.0.1:8000

# per-request timeout in ms
VITE_API_TIMEOUT=15000
